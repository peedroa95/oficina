generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { ADMINISTRADOR FUNCIONARIO }
enum OrderStatus { ABERTA AGUARDANDO_DIAGNOSTICO AGUARDANDO_APROVACAO EM_ANDAMENTO AGUARDANDO_PECA FINALIZADA ENTREGUE CANCELADA }
enum PaymentStatus { PENDENTE PARCIAL PAGO }
enum TransactionType { ENTRADA SAIDA }
enum StockMovementType { ENTRADA SAIDA ESTORNO }

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role Role @default(FUNCIONARIO)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("users")
}

model Customer {
  id String @id @default(cuid())
  name String
  document String? @unique
  phone String?
  whatsapp String?
  email String?
  zipCode String?
  address String?
  number String?
  district String?
  city String?
  state String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vehicles Vehicle[]
  orders ServiceOrder[]
  @@index([name])
  @@index([phone])
  @@map("customers")
}

model Vehicle {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Restrict)
  plate String @unique
  brand String
  model String
  year Int?
  color String?
  mileage Int @default(0)
  fuel String?
  chassis String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders ServiceOrder[]
  @@index([customerId])
  @@map("vehicles")
}

model Service {
  id String @id @default(cuid())
  name String @unique
  description String?
  defaultPrice Decimal @db.Decimal(12,2)
  active Boolean @default(true)
  orderItems ServiceOrderService[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("services")
}

model Product {
  id String @id @default(cuid())
  code String @unique
  name String
  category String?
  brand String?
  description String?
  quantity Int @default(0)
  minimumStock Int @default(0)
  costPrice Decimal @db.Decimal(12,2)
  salePrice Decimal @db.Decimal(12,2)
  supplier String?
  movements StockMovement[]
  orderItems ServiceOrderProduct[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name])
  @@map("products")
}

model ServiceOrder {
  id String @id @default(cuid())
  number Int @unique @default(autoincrement())
  customerId String
  vehicleId String
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Restrict)
  vehicle Vehicle @relation(fields:[vehicleId], references:[id], onDelete:Restrict)
  entryDate DateTime @default(now())
  mileage Int
  complaint String
  diagnosis String?
  notes String?
  discount Decimal @default(0) @db.Decimal(12,2)
  total Decimal @default(0) @db.Decimal(12,2)
  paymentMethod String?
  status OrderStatus @default(ABERTA)
  paymentStatus PaymentStatus @default(PENDENTE)
  completedAt DateTime?
  stockDeducted Boolean @default(false)
  services ServiceOrderService[]
  products ServiceOrderProduct[]
  payments Payment[]
  movements StockMovement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@map("service_orders")
}

model ServiceOrderService {
  id String @id @default(cuid())
  serviceOrderId String
  serviceId String?
  serviceOrder ServiceOrder @relation(fields:[serviceOrderId], references:[id], onDelete:Cascade)
  service Service? @relation(fields:[serviceId], references:[id], onDelete:SetNull)
  description String
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  subtotal Decimal @db.Decimal(12,2)
  @@map("service_order_services")
}

model ServiceOrderProduct {
  id String @id @default(cuid())
  serviceOrderId String
  productId String
  serviceOrder ServiceOrder @relation(fields:[serviceOrderId], references:[id], onDelete:Cascade)
  product Product @relation(fields:[productId], references:[id], onDelete:Restrict)
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  subtotal Decimal @db.Decimal(12,2)
  @@map("service_order_products")
}

model StockMovement {
  id String @id @default(cuid())
  productId String
  serviceOrderId String?
  product Product @relation(fields:[productId], references:[id], onDelete:Restrict)
  serviceOrder ServiceOrder? @relation(fields:[serviceOrderId], references:[id], onDelete:SetNull)
  type StockMovementType
  quantity Int
  reason String
  createdAt DateTime @default(now())
  @@index([productId])
  @@map("stock_movements")
}

model Payment {
  id String @id @default(cuid())
  serviceOrderId String
  serviceOrder ServiceOrder @relation(fields:[serviceOrderId], references:[id], onDelete:Restrict)
  amount Decimal @db.Decimal(12,2)
  method String
  paidAt DateTime @default(now())
  transaction FinancialTransaction?
  createdAt DateTime @default(now())
  @@map("payments")
}

model FinancialTransaction {
  id String @id @default(cuid())
  description String
  category String
  type TransactionType
  amount Decimal @db.Decimal(12,2)
  date DateTime @default(now())
  paymentMethod String?
  status String @default("PAGO")
  notes String?
  paymentId String? @unique
  payment Payment? @relation(fields:[paymentId], references:[id], onDelete:SetNull)
  createdAt DateTime @default(now())
  @@index([date])
  @@map("financial_transactions")
}

model WorkshopSettings {
  id String @id @default("default")
  name String @default("Minha Oficina")
  document String?
  phone String?
  whatsapp String?
  email String?
  address String?
  city String?
  state String?
  logoUrl String?
  receiptText String?
  orderText String?
  updatedAt DateTime @updatedAt
  @@map("workshop_settings")
}
