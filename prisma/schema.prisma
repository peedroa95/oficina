// Schema do banco de dados - Sistema de Oficina Mecânica
// Para migrar para PostgreSQL: troque provider para "postgresql" e ajuste DATABASE_URL no .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  document     String? // CPF ou CNPJ
  phone        String?
  whatsapp     String?
  address      String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicles     Vehicle[]
  serviceOrders ServiceOrder[]

  @@map("customers")
}

model Vehicle {
  id          String   @id @default(cuid())
  customerId  String
  plate       String
  brand       String
  model       String
  year        String?
  color       String?
  mileage     Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceOrders ServiceOrder[]

  @@index([plate])
  @@index([customerId])
  @@map("vehicles")
}

model Service {
  id           String  @id @default(cuid())
  name         String
  description  String?
  defaultPrice Float   @default(0)
  active       Boolean @default(true)

  orderServices ServiceOrderService[]

  @@map("services")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  code        String?
  brand       String?
  quantity    Int      @default(0)
  minStock    Int      @default(0)
  costPrice   Float    @default(0)
  salePrice   Float    @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderProducts ServiceOrderProduct[]
  stockMovements StockMovement[]

  @@map("products")
}

enum ServiceOrderStatus {
  ABERTA
  EM_ANDAMENTO
  FINALIZADA
  ENTREGUE
  CANCELADA
}

enum PaymentMethod {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
  TRANSFERENCIA
  OUTRO
}

enum PaymentStatus {
  PENDENTE
  PARCIAL
  PAGO
}

model ServiceOrder {
  id                String             @id @default(cuid())
  number            Int                @unique
  date              DateTime           @default(now())
  customerId        String
  vehicleId         String
  mileage           Int                @default(0)
  reportedProblem   String?
  notes             String?
  paymentMethod     PaymentMethod?
  discount          Float              @default(0)
  servicesTotal     Float              @default(0)
  productsTotal     Float              @default(0)
  total             Float              @default(0)
  paidAmount        Float              @default(0)
  paymentStatus     PaymentStatus      @default(PENDENTE)
  status            ServiceOrderStatus @default(ABERTA)
  stockDeducted     Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])

  services              ServiceOrderService[]
  products              ServiceOrderProduct[]
  payments              Payment[]
  financialTransactions FinancialTransaction[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@map("service_orders")
}

model ServiceOrderService {
  id             String  @id @default(cuid())
  serviceOrderId String
  serviceId      String?
  description    String
  quantity       Float   @default(1)
  unitPrice      Float   @default(0)
  subtotal       Float   @default(0)

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id])

  @@map("service_order_services")
}

model ServiceOrderProduct {
  id             String  @id @default(cuid())
  serviceOrderId String
  productId      String?
  description    String
  quantity       Float   @default(1)
  unitPrice      Float   @default(0)
  subtotal       Float   @default(0)

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id])

  @@map("service_order_products")
}

model Payment {
  id             String        @id @default(cuid())
  serviceOrderId String
  method         PaymentMethod
  amount         Float
  date           DateTime      @default(now())
  notes          String?

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum TransactionType {
  ENTRADA
  SAIDA
}

model FinancialTransaction {
  id             String          @id @default(cuid())
  type           TransactionType
  description    String
  amount         Float
  date           DateTime        @default(now())
  category       String?
  serviceOrderId String?

  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id])

  @@index([date])
  @@map("financial_transactions")
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  type      String // ENTRADA | SAIDA
  quantity  Int
  reason    String?
  date      DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}

model WorkshopSettings {
  id        String  @id @default(cuid())
  name      String  @default("Minha Oficina")
  document  String?
  phone     String?
  whatsapp  String?
  address   String?
  city      String?
  state     String?
  logo      String?

  @@map("workshop_settings")
}
